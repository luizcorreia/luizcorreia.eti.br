---
interface Props {
  name: 'github' | 'grid' | 'home' | 'instagram' | 'search' | 'theme' | 'twitter' | 'up' | 'youtube'
}

const { name } = Astro.props
const isBrand = ['github', 'instagram', 'twitter', 'youtube'].includes(name)
---

